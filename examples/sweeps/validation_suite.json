    {"molecule": "h_chain", "n_atoms": 6, "geometries": [1.0, 2.0]},
    {"molecule": "h4", "geometries": [80, 90, 100]},
    {"molecule": "lih", "geometries": [1.6, 3.0], "spin": ["s0", "t1"],
